node_modules/
dist/
release/
electron/
build/
workspace/
# Scratch files this workflow writes into the repo root. They belong in %TEMP%,
# but ignoring them stops a commit-message draft from being pushed by accident.
.tmp/
.tmp-*
attachments/
.iexa-artifacts/
.runtime/

# Native desktop-agent build intermediates
desktop-agent/bin/
desktop-agent/obj/
desktop-agent/publish-next/

# Build output
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# Electron / distribution artifacts
*.zip
convert-icon.js

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local SSH configuration and host fingerprints must never enter the repository.
.ssh/

# Debug logs
debug.log
*.log

# Environment
.env
.env.*

# Temp files
*.tmp
*.swp
*~
/.tmp/

# Accidental shell artifacts (PowerShell redirect mistakes)
/$null
/-p/

# Runtime state. The server defaults its workspace to the process cwd, so a
# manual run from the repo root writes these into the checkout. They are data,
# not source: the real home is workspace/ (or IEXA_WORKSPACE).
/.iexa-memory/
/.iexa-sessions/
/.iexa-sessions.json
/.iexa-skills.json
/.iexa-mobile-bridge.json
/.iexa-mobile-bridge.json.bak
/.iexa-goals.json
/.iexa-token-usage.json
/.iexa-settings.json
/.iexa-appearance.json
/.iexa-project.json
/.iexa-jobs.json
/skills/
