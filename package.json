{
  "name": "iexa-win",
  "version": "1.0.0",
  "description": "IEXA-WIN - Your private Windows AI agent",
  "main": "electron-entry.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main/server.js",
    "electron": "npm run build && electron .",
    "dev": "tsc && node dist/main/server.js"
  },
  "build": {
    "appId": "app.IEXA.desktop",
    "productName": "IEXA-WIN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "electron-entry.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "marked": "^12.0.2",
    "webdav": "^4.11.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0"
  }
}
